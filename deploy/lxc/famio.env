# Famio server configuration (/etc/famio/famio.env)
FAMIO_PORT=8765
FAMIO_DATA_DIR=/var/lib/famio
# Encryption key (created by install.sh) – back it up separately!
FAMIO_KEY_FILE=/etc/famio/famio.key
# HTTPS with Famio's own certificate for apps in the home network (0 = off):
FAMIO_TLS_PORT=8766
# Refuse plain HTTP API access from the network. Temporarily set this to false
# only while migrating an old client that cannot use HTTPS yet.
FAMIO_REQUIRE_TLS=true
TZ=Europe/Berlin
# Public HTTPS address behind Nginx Proxy Manager (for Google/iCloud calendars):
#FAMIO_PUBLIC_URL=https://famio.example.de/
# Only if port 8765 is reachable from the proxy alone:
#FAMIO_TRUST_PROXY=true
#FAMIO_MAX_UPLOAD_MB=100
# Precise location history (1–365 days; can be overridden by an admin):
#FAMIO_LOCATION_HISTORY_DAYS=7
