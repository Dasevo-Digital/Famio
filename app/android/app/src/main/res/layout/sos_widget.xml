<?xml version="1.0" encoding="utf-8"?>
<!-- One red button; the whole widget is the tap target. Fits a 1x1 cell
     on small phones; sos_widget_large is used where there is room. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/sos_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:contentDescription="@string/sos_widget_label"
    android:padding="2dp">

    <LinearLayout
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:layout_gravity="center"
        android:background="@drawable/sos_widget_background_small"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingBottom="3dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:importantForAccessibility="no"
            android:shadowColor="#66000000"
            android:shadowDy="1"
            android:shadowRadius="3"
            android:text="SOS"
            android:textColor="#FFFFFFFF"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:importantForAccessibility="no"
            android:letterSpacing="0.06"
            android:shadowColor="#66000000"
            android:shadowDy="1"
            android:shadowRadius="2"
            android:text="@string/sos_short"
            android:textColor="#FFFFFFFF"
            android:textSize="9sp"
            android:textStyle="bold" />
    </LinearLayout>
</FrameLayout>
