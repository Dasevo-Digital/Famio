<?xml version="1.0" encoding="utf-8"?>
<!-- The emergency button: soft shadow, white ring, red gradient. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:top="5dp" android:left="2dp" android:right="2dp">
        <shape android:shape="oval">
            <solid android:color="#40000000" />
        </shape>
    </item>
    <item android:bottom="4dp">
        <shape android:shape="oval">
            <solid android:color="#FFFFFFFF" />
        </shape>
    </item>
    <item android:top="4dp" android:left="4dp" android:right="4dp" android:bottom="8dp">
        <shape android:shape="oval">
            <gradient
                android:angle="270"
                android:startColor="#FFF25C68"
                android:centerColor="#FFDE3A4B"
                android:endColor="#FFB8233A"
                android:type="linear" />
        </shape>
    </item>
    <!-- A faint light from above, so it reads as a button. -->
    <item android:top="8dp" android:left="18dp" android:right="18dp" android:bottom="52dp">
        <shape android:shape="oval">
            <solid android:color="#26FFFFFF" />
        </shape>
    </item>
</layer-list>
